    </outline>
    <outline text="World news">
      <outline type="rss" text="BBC News"
               xmlUrl="https://feeds.bbci.co.uk/news/rss.xml"/>
      <!-- the same feed again, as re-exported subscription lists often do -->
      <outline type="rss" text="BBC News (duplicate)"
               xmlUrl="https://feeds.bbci.co.uk/news/rss.xml"/>
    </outline>
    <outline type="rss" text="xkcd" xmlUrl="https://xkcd.com/rss.xml"/>
    <outline text="An empty folder"/>
    <outline type="link" text="Not a feed at all" htmlUrl="https://example.com/"/>
  </body>
